# Clerk — accounts and sessions. Copy this file to .env.local and fill in
# both keys from your Clerk application (Dashboard → API keys).
# The README has the step-by-step for creating the Clerk app.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Where Clerk sends people for auth (matches this app's routes).
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Google Gemini — powers note correction + vocab/verb/grammar extraction.
# Create a free key at https://aistudio.google.com (Get API key). Server-side
# only; it is never sent to the browser. Without it the app still runs, but
# extraction shows a "add the key" message instead of results.
# (GOOGLE_GENERATIVE_AI_API_KEY also works, if you already have one under
# that name.)
GEMINI_API_KEY=AIza...
# Optional: override the model (defaults to gemini-3.6-flash). Must be a
# model that supports generateContent with JSON-schema structured output.
# GEMINI_MODEL=gemini-3.6-flash
