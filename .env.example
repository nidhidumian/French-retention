# Clerk — accounts and sessions. Copy this file to .env.local and fill in
# both keys from your Clerk application (Dashboard → API keys).
# The README has the step-by-step for creating the Clerk app.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Where Clerk sends people for auth (matches this app's routes).
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
