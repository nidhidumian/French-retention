# Clerk — accounts and sessions. Copy this file to .env.local and fill in
# both keys from your Clerk application (Dashboard → API keys).
# The README has the step-by-step for creating the Clerk app.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Where Clerk sends people for auth (matches this app's routes).
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Mistral — powers note correction + vocab/verb/grammar extraction (the
# primary provider; French-first, reliable JSON output). Create a free key
# at https://console.mistral.ai (API Keys). Server-side only; it is never
# sent to the browser. Without it the app still runs, but extraction shows
# an "add the key" message instead of results.
MISTRAL_API_KEY=...
# Optional: override the model (defaults to mistral-small-latest).
# MISTRAL_MODEL=mistral-small-latest

# Optional: Google Gemini as a silent backup — used only when Mistral fails
# or MISTRAL_API_KEY is missing. Safe to leave unset or remove.
# (GOOGLE_GENERATIVE_AI_API_KEY also works, if you already have one under
# that name.)
# GEMINI_API_KEY=AIza...
# Optional: override the backup model (defaults to gemini-3.6-flash, with an
# automatic fallback to gemini-flash-latest).
# GEMINI_MODEL=gemini-3.6-flash
